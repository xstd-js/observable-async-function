{
  "name": "@xstd/observable-async-function",
  "version": "1.0.0",
  "type": "module",
  "description": "An async function whose call establishes a live ListenerResource emitting values over time",
  "keywords": [
    "observable",
    "async-function",
    "async",
    "broadcast",
    "listener",
    "emitter",
    "stream",
    "reactive",
    "async-iterator",
    "async-generator",
    "resource",
    "abortable",
    "signal",
    "lifecycle",
    "typescript"
  ],
  "author": "Valentin Richard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xstd-js/observable-async-function.git"
  },
  "packageManager": "yarn@4.18.1",
  "main": "./index.js",
  "scripts": {
    "=== FB: BUILD ===": "",
    "fb:build": "fabrique build",
    "=== FB: TEST ===": "",
    "fb:test": "vitest run",
    "fb:test:coverage": "vitest run --coverage",
    "fb:bench": "vitest bench",
    "=== FB: CODE QUALITY ===": "",
    "fb:format": "yarn fb:format:fix",
    "fb:format:check": "prettier --check --ignore-unknown --config .prettierrc \"./**/*.{js,jsx,ts,tsx,html,css,scss,json,md}\"",
    "fb:format:fix": "prettier --write --ignore-unknown --config .prettierrc \"./**/*.{js,jsx,ts,tsx,html,css,scss,json,md}\"",
    "fb:check": "yarn fb:check:types && yarn fb:format:check",
    "fb:check:types": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "=== FB: RELEASE ===": "",
    "fb:manual:release": "fabrique release",
    "fb:ci:release": "fabrique ci release",
    "=== FB: INIT ===": "",
    "fb:setup-github-repository": "fabrique setup-github-repository"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-istanbul": "^5.1.0",
    "fabrique": "2.0.36",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "npm:typescript@~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "access": "public",
  "dependencies": {
    "@xstd/async-function": "^1.3.1",
    "@xstd/equal-function": "^1.0.0",
    "@xstd/listener-resource": "^1.0.0",
    "@xstd/map-function": "^1.3.0",
    "@xstd/none": "^1.0.0",
    "@xstd/resource": "^1.0.0"
  },
  "fabrique": {
    "version": "2.0.36",
    "type": "lib"
  }
}
